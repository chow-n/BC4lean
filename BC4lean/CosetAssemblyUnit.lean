set_option autoImplicit false
set_option relaxedAutoImplicit false
set_option warningAsError true

/-! # The assembly map hits the averaging projection of every finite subgroup

Let `Γ` be a countable discrete group (in `Type`; upstream's assembly map is
universe-polymorphic) and `F ≤ Γ` a finite subgroup. The unit cycle of the proper
cocompact `Γ`-set `Γ ⧸ F` is `ℓ²(Γ ⧸ F)` with translations, the multiplication representation of
`C₀(Γ ⧸ F)` and operator `0`. Push its class into the canonical model of `E_FIN Γ` along the orbit
map of an `F`-fixed point (`CosetAssembly.toModel`; the point is chosen once, and the statements
are about this choice); call the result `[Γ ⧸ F] ∈ K^Γ_0(E_FIN Γ)`.
Then the reduced assembly map sends `[Γ ⧸ F]` to the class of the projection
`p_F = |F|⁻¹ ∑_{f ∈ F} λ_f ∈ C*_r(Γ)` (`reducedAssemblyHom_cosetUnitClass`), whose canonical trace
is `1 / |F|` (`reducedTraceK0_assembly_cosetUnitClass`). Hence the subgroup of `ℝ` generated by
the numbers `1 / |F|`, `F` finite, lies in the image of `τ_* ∘ μ₀` (`lambdaGroup_le`).
For `F = ⊥` the projection is `λ_1 = 1`, so the free orbit assembles to the class of the unit
projection, `μ₀[Γ] = [1]` (`reducedAssemblyHom_cosetUnitClass_bot`).

Proof: assembly on `E_FIN Γ` restricted to the piece `Γ ⧸ F` is the coset-space assembly with any
cutoff (`CosetAssembly.reducedAssemblyHom_toModel`); with the cutoff `|F|^{-1/2} 1_{eF}` the cutoff
product is the pullback along `z ↦ z • p` (`FinitePointCutoff.cutoffProductHom_eq_sourcePullback`);
compressed descent identifies the result with the identity class of `KK(ℂ, ℂ)` pushed along
`z ↦ z • P_F` (`CosetCompressedDescent.even_compressedDescent`); the scalar index of the identity
class is `[1]`, carried to `[P_F]`. -/

noncomputable section

namespace BC4lean.Chapter8Examples.CosetAssemblyUnit
open ProperActions KKTheory OperatorKTheory
open KKTheory.GroupUniverseParityGroup KKTheory.GroupUniverseParityFunctoriality
open KKTheory.FinitePointCharacterTensor KKTheory.CosetCompressedDescent
open Chapter8Examples.CosetAssembly Chapter8Examples.CosetUnitCycle
open Chapter8Examples.FinitePointAssembly (crossedHom)
open scoped ZeroAtInfty ComplexOrder KasparovDescent InnerProductSpace ScalarHilbertModule

/- The spectral order on `C*_r(Γ)`, as in `ReducedGroupTrace`. -/
local instance reducedSpectralOrder (Γ : Type) [Group Γ] :
    PartialOrder (ReducedGroupCStar Γ) :=
  CStarAlgebra.spectralOrder _
local instance reducedSpectralOrderedRing (Γ : Type) [Group Γ] :
    StarOrderedRing (ReducedGroupCStar Γ) :=
  CStarAlgebra.spectralOrderedRing _

section Projection
variable {Γ : Type} [Group Γ] [Countable Γ] (F : Subgroup Γ) [Fintype F]

variable (Γ) in
/-- `p_F = |F|⁻¹ ∑_{f ∈ F} λ_f ∈ C*_r(Γ)`, the image of `P_F`. -/
abbrev subgroupElement : ReducedGroupCStar Γ := crossedHom Γ (subgroupProjection Γ F)

theorem subgroupElement_eq :
    subgroupElement Γ F = (Nat.card F : ℂ)⁻¹ • ∑ f : F, reducedDelta Γ (f : Γ) := by
  rw [subgroupElement, subgroupProjection, map_sum, Finset.smul_sum]
  refine Finset.sum_congr rfl fun f _ => ?_
  rw [map_smul, FiniteAssemblyUnit.crossedHom_regular_eq_reducedDelta]

theorem subgroupElement_isStarProjection : IsStarProjection (subgroupElement Γ F) :=
  (subgroupProjection_isStarProjection Γ F).map (crossedHom Γ)

/-- `z ↦ z • P_F`, read in `C*_r(Γ)`, sends `1` to `p_F`. -/
theorem crossedHom_subgroupHom_one :
    (crossedHom Γ).comp (subgroupHom Γ F) 1 = subgroupElement Γ F := by
  change crossedHom Γ ((1 : ℂ) • subgroupProjection Γ F) = _
  rw [one_smul]

/-- `τ(p_F) = 1 / |F|`. -/
theorem reducedTrace_subgroupElement :
    (reducedTrace Γ).toLinearMap (subgroupElement Γ F) = (Nat.card F : ℂ)⁻¹ := by
  classical
  rw [subgroupElement_eq, map_smul, map_sum]
  simp only [reducedTrace_reducedDelta, OneMemClass.coe_eq_one]
  rw [Finset.sum_ite_eq' Finset.univ (1 : F) (fun _ => (1 : ℂ)), if_pos (Finset.mem_univ _),
    smul_eq_mul, mul_one]

variable (Γ) in
/-- `[p_F] ∈ K₀(C*_r Γ)`. -/
def subgroupK0Class : ReducedK0 Γ :=
  reducedK0Class Γ (StableProjectionMonoid.of (FiniteProjection.ofProjection
    (unitMatrixProjection (subgroupElement Γ F) (subgroupElement_isStarProjection F))))

/-- `τ_*[p_F] = 1 / |F|`. -/
theorem reducedTraceK0_subgroupK0Class :
    reducedTraceK0 Γ (subgroupK0Class Γ F) = (Nat.card F : ℝ)⁻¹ := by
  rw [subgroupK0Class, reducedTraceK0_class]
  change ((reducedTrace Γ).projectionTrace
    (unitMatrixProjection (subgroupElement Γ F) (subgroupElement_isStarProjection F))).re = _
  rw [TracialFunctional.projectionTrace_unitMatrixProjection, reducedTrace_subgroupElement]
  simp

omit [Countable Γ] [Fintype F] in
theorem k0Projection_unitMatrixProjection_congr {e e' : ReducedGroupCStar Γ} (h : e = e')
    (he : IsStarProjection e) (he' : IsStarProjection e') :
    k0Projection (FiniteProjection.ofProjection (unitMatrixProjection e he)) =
      k0Projection (FiniteProjection.ofProjection (unitMatrixProjection e' he')) := by
  subst h
  rfl

end Projection

section Assembly
variable {Γ : Type} [Group Γ] [Countable Γ] [TopologicalSpace Γ] [DiscreteTopology Γ]
  (F : Subgroup Γ) [Fintype F]

local instance cosetCZero_separable : TopologicalSpace.SeparableSpace C₀(Γ ⧸ F, ℂ) :=
  TopologicalKHomology.cZero_separableSpace

local instance model_proper : ProperSMul Γ (LabeledOrbitTelescope.Model Γ) :=
  LabeledOrbitTelescope.proper Γ

local instance piece_locallyCompact :
    LocallyCompactSpace (wholePiece Γ F).toInvariantSubset := (wholePiece Γ F).locallyCompact

omit [Countable Γ] [TopologicalSpace Γ] [DiscreteTopology Γ] [Fintype F] in
theorem inner_baseVector_self_complex : ⟪baseVector Γ F, baseVector Γ F⟫_ℂ = 1 := by
  simpa using congrArg MulOpposite.unop (inner_baseVector_self Γ F)

omit [Fintype F] in
theorem unitCycle_representation_cosetDelta_complex (ξ : L2Group (Γ ⧸ F)) :
    (unitCycle Γ F).representation (cosetDelta Γ F) ξ = ⟪baseVector Γ F, ξ⟫_ℂ • baseVector Γ F := by
  rw [unitCycle_representation_cosetDelta_apply]
  rfl

variable (Γ) in
/-- The class of the unit cycle of `Γ ⧸ F` in `K^Γ_0(Γ ⧸ F)`. -/
def cosetCycleClass : TopologicalKHomology.spaceGroup false Γ (Γ ⧸ F) :=
  KasparovHomotopyClass.mk (BundledKasparovCycle.of (unitCycle Γ F))

/-- The coset-space assembly of the unit cycle is `[P_F]`, read in `C*_r(Γ)`. -/
theorem spaceAssembly_unitCycle :
    Assembly.spaceAssemblyHom Γ (Γ ⧸ F) false (baseCutoff Γ F) (cosetCycleClass Γ F) =
      operatorK0UnitalEquiv (ReducedGroupCStar Γ)
        (operatorK0Map ((crossedHom Γ).comp (subgroupHom Γ F))
          (nonunitalProjectionK0 (1 : ℂ) (IsStarProjection.one ℂ))) := by
  change Assembly.reducedScalarKKToAnalyticHom Γ false (Assembly.cutoffProductHom Γ (Γ ⧸ F)
    false (baseCutoff Γ F) (KasparovDescent.classHom (scalarAction Γ) (cosetAction F) false
      (KasparovHomotopyClass.mk (BundledKasparovCycle.of (unitCycle Γ F))))) = _
  rw [FinitePointCutoff.cutoffProductHom_eq_sourcePullback Γ (Γ ⧸ F) false (baseCutoff Γ F)
    (cutoffHom F) (FinitePointCutoff.projectionScalarHom_one _ _)]
  erw [even_compressedDescent (inner_baseVector_self_complex F) (unitCycle Γ F)
    (unitCycle_representation_cosetDelta_complex F) (unitCycle_action_baseVector Γ F)
    (unitCycle_operator Γ F) (unitCycle_grading Γ F)]
  change operatorK0UnitalEquiv (ReducedGroupCStar Γ) (operatorK0Map (crossedHom Γ)
    (scalarKKOperatorK0AddEquiv (GroupUniverseOrdinaryEven.coefficientPushforward.{0,0,0}
      (subgroupHom Γ F) _))) = _
  rw [scalarKKOperatorK0AddEquiv_natural, ← AddMonoidHom.comp_apply, ← operatorK0Map_comp,
    ScalarUnitProjection.scalarKKOperatorK0AddEquiv_identity]

variable (Γ) in
/-- `[Γ ⧸ F] ∈ K^Γ_0(E_FIN Γ)`: the unit cycle of `Γ ⧸ F`, pushed into the whole cocompact piece
and along the orbit map of the `F`-fixed point `CosetAssembly.fixedPoint` of the canonical model.
That point is a choice; the class is defined for it, and the theorems below are about it. -/
def cosetUnitClass : TopologicalKHomology.topologicalGroup false Γ :=
  TopologicalKHomology.pushforward false (toModel Γ F)
    (TopologicalKHomology.ofPiece false (wholePiece Γ F)
      (TopologicalKHomology.properPushforward false (wholeLift Γ F) (wholeLift_proper Γ F)
        (cosetCycleClass Γ F)))

/-- `μ₀[Γ ⧸ F] = [p_F]`, `p_F = |F|⁻¹ ∑_{f ∈ F} λ_f`, for every finite subgroup `F` of a
countable discrete group `Γ : Type`. -/
theorem reducedAssemblyHom_cosetUnitClass :
    Assembly.reducedAssemblyHom Γ false (cosetUnitClass Γ F) = subgroupK0Class Γ F := by
  rw [cosetUnitClass, reducedAssemblyHom_toModel Γ F false (baseCutoff Γ F),
    spaceAssembly_unitCycle, nonunitalProjectionK0_map, operatorK0UnitalEquiv_nonunitalProjectionK0]
  exact k0Projection_unitMatrixProjection_congr (crossedHom_subgroupHom_one F) _ _

/-- `[p_F]` lies in the range of `μ₀`. -/
theorem subgroupK0Class_mem_range :
    subgroupK0Class Γ F ∈ (Assembly.reducedAssemblyHom Γ false).range :=
  ⟨cosetUnitClass Γ F, reducedAssemblyHom_cosetUnitClass F⟩

/-- `τ_* μ₀[Γ ⧸ F] = 1 / |F|`. -/
theorem reducedTraceK0_assembly_cosetUnitClass :
    reducedTraceK0 Γ (Assembly.reducedAssemblyHom Γ false (cosetUnitClass Γ F)) =
      (Nat.card F : ℝ)⁻¹ := by
  rw [reducedAssemblyHom_cosetUnitClass, reducedTraceK0_subgroupK0Class]

/-- `1 / |F| ∈ τ_*(range μ₀)`. -/
theorem inv_card_mem_traceRange :
    (Nat.card F : ℝ)⁻¹ ∈ (Assembly.reducedAssemblyHom Γ false).range.map (reducedTraceK0 Γ) :=
  ⟨subgroupK0Class Γ F, subgroupK0Class_mem_range F, reducedTraceK0_subgroupK0Class F⟩

end Assembly

section Lambda
variable (Γ : Type) [Group Γ] [Countable Γ] [TopologicalSpace Γ] [DiscreteTopology Γ]

/-- `Λ_Γ`, the additive subgroup of `ℝ` generated by `1 / |F|` for the finite subgroups `F ≤ Γ`. -/
def lambdaGroup : AddSubgroup ℝ :=
  AddSubgroup.closure {r | ∃ F : Subgroup Γ, Finite F ∧ r = (Nat.card F : ℝ)⁻¹}

/-- `Λ_Γ ⊆ τ_*(range μ₀)`: every `1 / |F|` is the trace of an assembled class. This is the known
inclusion; it implies the `⊇` half of the original trace conjecture, which on its own already follows
from `p_F ∈ ℂΓ`. The reverse inclusion fails in general (Roy's example). -/
theorem lambdaGroup_le :
    lambdaGroup Γ ≤ (Assembly.reducedAssemblyHom Γ false).range.map (reducedTraceK0 Γ) := by
  rw [lambdaGroup, AddSubgroup.closure_le]
  rintro r ⟨F, hF, rfl⟩
  let : Fintype F := Fintype.ofFinite F
  exact inv_card_mem_traceRange F

/-- `F = 1`: the free orbit `Γ` has `τ_* μ₀[Γ] = 1`. -/
theorem reducedTraceK0_assembly_cosetUnitClass_bot :
    letI : Fintype (⊥ : Subgroup Γ) := Fintype.ofFinite _
    reducedTraceK0 Γ (Assembly.reducedAssemblyHom Γ false (cosetUnitClass Γ (⊥ : Subgroup Γ))) = 1 := by
  let : Fintype (⊥ : Subgroup Γ) := Fintype.ofFinite _
  rw [reducedTraceK0_assembly_cosetUnitClass, Subgroup.card_bot, Nat.cast_one, inv_one]

/-- `μ₀ ≠ 0` in degree `0`, for every countable discrete group `Γ : Type`. -/
theorem reducedAssemblyHom_ne_zero : Assembly.reducedAssemblyHom Γ false ≠ 0 := by
  intro h
  have h1 := reducedTraceK0_assembly_cosetUnitClass_bot Γ
  rw [h, AddMonoidHom.zero_apply] at h1
  exact zero_ne_one ((map_zero (reducedTraceK0 Γ)).symm.trans h1 : (0 : ℝ) = 1)

end Lambda

section FreeOrbit
variable (Γ : Type) [Group Γ] [Countable Γ]

omit [Countable Γ] in
/-- `λ_e = 1` in `C*_r(Γ)`. -/
theorem reducedDelta_one : reducedDelta Γ (1 : Γ) = 1 := by
  rw [reducedDelta, GroupAlgebra.delta_one, map_one]

/-- The averaging projection of the trivial subgroup is `1`. -/
theorem subgroupElement_bot [Fintype (⊥ : Subgroup Γ)] :
    subgroupElement Γ (⊥ : Subgroup Γ) = 1 := by
  rw [subgroupElement_eq, Subgroup.card_bot, Nat.cast_one, inv_one, one_smul,
    Finset.univ_unique, Finset.sum_singleton]
  have h : ((default : (⊥ : Subgroup Γ)) : Γ) = 1 := Subgroup.mem_bot.mp (default : (⊥ : Subgroup Γ)).2
  rw [h, reducedDelta_one]

/-- The `1 × 1` matrix with entry `1` is the unit projection. -/
theorem unitMatrixProjection_one {A : Type*} [CStarAlgebra A] [PartialOrder A] [StarOrderedRing A] :
    unitMatrixProjection (1 : A) (IsStarProjection.one A) =
      (Projection.one : MatrixProjection A Unit) := by
  apply Subtype.ext
  ext i j
  change (1 : A) = (1 : CStarMatrix Unit Unit A) i j
  rw [Subsingleton.elim i j]
  exact (Matrix.one_apply_eq (α := A) j).symm

/-- `[p_⊥] = [1]`: the class of the trivial subgroup's averaging projection is the class of the
`1 × 1` unit projection. -/
theorem subgroupK0Class_bot [Fintype (⊥ : Subgroup Γ)] :
    subgroupK0Class Γ (⊥ : Subgroup Γ) =
      letI := CStarAlgebra.spectralOrder (ReducedGroupCStar Γ)
      letI := CStarAlgebra.spectralOrderedRing (ReducedGroupCStar Γ)
      k0Projection (FiniteProjection.ofProjection
        (Projection.one : MatrixProjection (ReducedGroupCStar Γ) Unit)) := by
  let := CStarAlgebra.spectralOrder (ReducedGroupCStar Γ)
  let := CStarAlgebra.spectralOrderedRing (ReducedGroupCStar Γ)
  change k0Projection (FiniteProjection.ofProjection
    (unitMatrixProjection (subgroupElement Γ (⊥ : Subgroup Γ))
      (subgroupElement_isStarProjection (⊥ : Subgroup Γ)))) = _
  rw [k0Projection_unitMatrixProjection_congr (subgroupElement_bot Γ) _ (IsStarProjection.one _),
    unitMatrixProjection_one]

variable [TopologicalSpace Γ] [DiscreteTopology Γ]

/-- **`μ₀[Γ] = [1]`** for every countable discrete group `Γ : Type`: the free orbit's unit class
assembles to the class of the `1 × 1` unit projection of `C*_r(Γ)`. -/
theorem reducedAssemblyHom_cosetUnitClass_bot [Fintype (⊥ : Subgroup Γ)] :
    Assembly.reducedAssemblyHom Γ false (cosetUnitClass Γ (⊥ : Subgroup Γ)) =
      letI := CStarAlgebra.spectralOrder (ReducedGroupCStar Γ)
      letI := CStarAlgebra.spectralOrderedRing (ReducedGroupCStar Γ)
      k0Projection (FiniteProjection.ofProjection
        (Projection.one : MatrixProjection (ReducedGroupCStar Γ) Unit)) := by
  rw [reducedAssemblyHom_cosetUnitClass, subgroupK0Class_bot]

end FreeOrbit

end BC4lean.Chapter8Examples.CosetAssemblyUnit
